# Porta da API
PORT=3000
# PostgreSQL (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=
# 0 para banco local sem TLS
DATABASE_SSL=1
# Token de acesso da API (gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
API_TOKEN=
# Chave do Google AI Studio (lida pelo SDK @google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Origens do front autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://douglasabnovato.github.io
MAX_UPLOAD_MB=5
